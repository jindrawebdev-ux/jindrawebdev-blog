# Block direct web access to the blog's raw data files.
#
# blog.php and article.php read these off disk server-side, so nothing
# here needs to be reachable over HTTP. Blocking it also stops Google
# indexing the raw article HTML fragments (e.g. /blog-data/content/foo.html)
# as thin duplicate copies of your real article pages.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
